+
+func TestAntigravityBuildRequestPreservesExplicitOutputLimit(t *testing.T) {
+	for _, modelName := range []string{"gemini-3.8-flash", "claude-opus-4-6"} {
+		for _, toolsJSON := range []string{"[]", `[{"functionDeclarations":[{"name":"read","parametersJsonSchema":{"type":"object","properties":{"path":{"type":"string"}}}}]}]`} {
+			t.Run(modelName+toolsJSON, func(t *testing.T) {
+				payload := []byte(`{"request":{"contents":[{"role":"user","parts":[{"text":"hello"}]}],"generationConfig":{"maxOutputTokens":1200},"tools":` + toolsJSON + `}}`)
+				body := buildRequestBodyFromRawPayload(t, modelName, payload)
+				request := body["request"].(map[string]any)
+				generation := request["generationConfig"].(map[string]any)
+				if generation["maxOutputTokens"] != float64(1200) {
+					t.Fatalf("output limit was changed or removed: %v", generation["maxOutputTokens"])
+				}
+			})
+		}
+	}
+}
+
+func TestAntigravityBuildRequestDoesNotInventOutputLimit(t *testing.T) {
+	body := buildRequestBodyFromRawPayload(t, "gemini-3.8-flash", []byte(`{"request":{"contents":[{"role":"user","parts":[{"text":"hello"}]}]}}`))
+	request := body["request"].(map[string]any)
+	if generation, ok := request["generationConfig"].(map[string]any); ok {
+		if _, exists := generation["maxOutputTokens"]; exists {
+			t.Fatal("request without an output limit acquired one")
 		}
 	}
 }
